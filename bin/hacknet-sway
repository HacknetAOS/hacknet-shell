#!/bin/sh
# HacknetOS Sway session entrypoint (fallback/testing)
# Used by the headless test harness and as a fallback.

unset DISPLAY
export GDK_BACKEND=wayland
export GTK_THEME=Adwaita-dark
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -n "$XDG_RUNTIME_DIR" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
fi

export XDG_CURRENT_DESKTOP=HacknetOS
export XDG_SESSION_DESKTOP=HacknetOS
export XDG_SESSION_TYPE=wayland

# Some login paths hand the session an empty/C locale; foot refuses to start
# without a UTF-8 locale, so pin one.
case "${LANG:-C}" in
    C|POSIX|"") export LANG=en_US.UTF-8 ;;
esac
export HACKNET_BACKEND=sway

mkdir -p "$XDG_RUNTIME_DIR/hacknet"

# Export session identity to dbus activation environment.
# Note: WAYLAND_DISPLAY and portal service activation occur after the compositor
# starts up (see sway/hacknet.conf and hyprland/hacknet.lua) so that xdg-desktop-portal-gtk
# can connect to the live Wayland display instead of failing on startup.
dbus-update-activation-environment --systemd \
    XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true

if [ ! -f "$XDG_STATE_HOME/hacknet/theme/current" ]; then
    hacknet-theme apply blue &
fi

if ! pgrep -x pipewire >/dev/null; then
    pipewire &
    wireplumber &
fi

hacknetd &
sleep 0.5

( sleep 2; hacknet-layout --watch >/dev/null 2>&1 ) &
exec quickshell -p /usr/share/quickshell/hacknet/shell.qml